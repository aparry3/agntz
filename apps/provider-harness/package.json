{
  "name": "@agntz/provider-harness",
  "version": "0.1.7",
  "private": true,
  "description": "Multi-provider smoke harness for the agntz SDK — runs capability tests across (provider, model) combinations",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env.local --env-file-if-exists=../../.env.local src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "tsx --env-file-if-exists=.env.local --env-file-if-exists=../../.env.local src/index.ts --suite smoke --sdk both --require-credentials --global-concurrency 2 --provider-concurrency 1",
    "test:compat": "tsx --env-file-if-exists=.env.local --env-file-if-exists=../../.env.local src/index.ts --suite compat --sdk both --require-credentials --global-concurrency 2 --provider-concurrency 1",
    "lint": "biome check src tests --no-errors-on-unmatched",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agntz/core": "workspace:*",
    "@agntz/stores": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
