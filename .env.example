# ═══════════════════════════════════════════════════════════════
# Store
# ═══════════════════════════════════════════════════════════════
STORE=memory                     # memory | postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agntz
MEMREZ_STORE=memory              # memory | postgres | disabled (defaults to STORE)
MEMREZ_DATABASE_URL=             # optional: separate Postgres URL for memrez
MEMREZ_TABLE_PREFIX=             # optional: prefix for memrez_* tables

# ═══════════════════════════════════════════════════════════════
# Worker
# ═══════════════════════════════════════════════════════════════
WORKER_URL=http://localhost:4001  # URL where the worker is running
PORT=4001                         # Worker port
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DOCS_DIR=../../docs               # Path to docs directory (for read_file tool)
BUILT_IN_AGENTS_DIR=../../examples/agents  # Path to built-in agent YAMLs

# Managed image/audio artifacts. Use memory for disposable development,
# filesystem for one persistent worker, or S3 for multiple replicas.
ARTIFACT_STORE=memory               # memory | filesystem | s3
ARTIFACT_DIR=.agntz-artifacts       # filesystem only
ARTIFACT_S3_BUCKET=                 # required for s3
ARTIFACT_S3_PREFIX=agntz-artifacts
ARTIFACT_S3_ENDPOINT=               # optional S3-compatible endpoint
ARTIFACT_S3_FORCE_PATH_STYLE=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ═══════════════════════════════════════════════════════════════
# Auth (Clerk) — required for the Next.js app
# ═══════════════════════════════════════════════════════════════
# Sign up at https://clerk.com, create a dev app. (No Organizations needed.)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/agents
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/agents

# Shared secret the Next.js app uses to talk to the worker. The worker trusts
# X-Internal-Secret requests and reads userId from the body. Generate a random
# string (e.g. `openssl rand -base64 32`). Must match in both env files.
WORKER_INTERNAL_SECRET=replace-me-with-32-random-bytes

# ═══════════════════════════════════════════════════════════════
# Default Model
# ═══════════════════════════════════════════════════════════════
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-5.6-terra
# Use OpenRouter as default for one-key access to 300+ models:
# DEFAULT_MODEL_PROVIDER=openrouter
# DEFAULT_MODEL_NAME=anthropic/claude-sonnet-5

# ═══════════════════════════════════════════════════════════════
# LLM Provider API Keys (set the ones you need)
# ═══════════════════════════════════════════════════════════════
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenRouter — proxy to 300+ models (Anthropic, Google, Meta, DeepSeek, OSS) with one key
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
COHERE_API_KEY=
AZURE_OPENAI_API_KEY=
