{
  "name": "@agntz/core",
  "version": "0.5.1",
  "description": "TypeScript SDK for defining and running AI agents with first-class MCP support and pluggable storage",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "import": "./dist/manifest/index.js"
    },
    "./schema": "./schema/agent-manifest.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "lint": "biome check src tests --no-errors-on-unmatched",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "llm",
    "typescript",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aparry3/agntz.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/aparry3/agntz#readme",
  "author": "Aaron Bidworthy",
  "dependencies": {
    "@agntz/contracts": "workspace:*",
    "ai": "^7.0.0",
    "nanoid": "^5.1.16",
    "yaml": "^2.8.0",
    "zod": "^3.25.0",
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/mistral": "^4.0.0",
    "@ai-sdk/xai": "^4.0.0",
    "@ai-sdk/groq": "^4.0.0",
    "@ai-sdk/deepseek": "^3.0.0",
    "@ai-sdk/perplexity": "^4.0.0",
    "@ai-sdk/cohere": "^4.0.0",
    "@ai-sdk/azure": "^4.0.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agntz/stores": "workspace:*",
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
