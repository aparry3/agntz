{
  "name": "@agntz/worker",
  "version": "0.2.1",
  "private": true,
  "description": "Hono server for agent execution — runs YAML-defined agents via the manifest engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agntz-worker": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node --env-file=.env.local dist/server.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check src tests --no-errors-on-unmatched",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aparry3/agntz.git",
    "directory": "packages/worker"
  },
  "dependencies": {
    "@agntz/contracts": "workspace:*",
    "@agntz/core": "workspace:*",
    "@agntz/memrez": "workspace:*",
    "@agntz/stores": "workspace:*",
    "@ai-sdk/openai": "^4.0.29",
    "@aws-sdk/client-s3": "^3.1102.0",
    "@hono/node-server": "^2.1.0",
    "ai": "^7.0.51",
    "dotenv": "^17.4.2",
    "hono": "^4.13.0",
    "pg": "^8.22.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
