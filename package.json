{
  "name": "agntz-monorepo",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "build": "turbo build",
    "build:app": "pnpm --filter @agntz/app build",
    "build:site": "pnpm --filter @agntz/site build",
    "test": "turbo test",
    "test:packed": "turbo build --filter=@agntz/contracts --filter=@agntz/client --filter=@agntz/db --filter=@agntz/core --filter=@agntz/stores --filter=@agntz/memrez --filter=@agntz/sdk && node scripts/test-packed-consumer.mjs",
    "test:providers:smoke": "pnpm --filter @agntz/provider-harness test:smoke",
    "test:providers:compat": "pnpm --filter @agntz/provider-harness test:compat",
    "lint": "turbo lint",
    "format": "biome check --write packages/*/src packages/*/tests apps/provider-harness/src apps/provider-harness/tests --no-errors-on-unmatched",
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "turbo dev",
    "dev:app": "pnpm --filter @agntz/app dev",
    "dev:site": "pnpm --filter @agntz/site dev",
    "dev:worker": "pnpm --filter @agntz/worker dev",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.11"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.5",
      "@hono/node-server": "1.19.13",
      "hono": "4.12.29",
      "ip-address": "10.3.1",
      "path-to-regexp": "8.4.0",
      "postcss": "8.5.26",
      "qs": "6.15.3",
      "sharp": "0.35.3",
      "uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
