# ═══════════════════════════════════════════════════════════════
# Base
# ═══════════════════════════════════════════════════════════════
FROM node:26-slim AS base
RUN corepack enable && corepack prepare pnpm@10 --activate
WORKDIR /app

# ═══════════════════════════════════════════════════════════════
# Dependencies
# ═══════════════════════════════════════════════════════════════
FROM base AS deps
RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3 make g++ \
	&& rm -rf /var/lib/apt/lists/*
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json turbo.json ./
COPY scripts/install-hooks.mjs scripts/install-hooks.mjs
COPY packages/contracts/package.json packages/contracts/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/memrez/package.json packages/memrez/
COPY packages/stores/package.json packages/stores/
COPY packages/worker/package.json packages/worker/
RUN pnpm install --frozen-lockfile

# ═══════════════════════════════════════════════════════════════
# Build
# ═══════════════════════════════════════════════════════════════
FROM deps AS build
COPY packages/ packages/
RUN pnpm --filter @agntz/contracts build
RUN pnpm --filter @agntz/core build
RUN pnpm --filter @agntz/db build
RUN pnpm --filter @agntz/stores build
RUN pnpm --filter @agntz/memrez build
RUN pnpm --filter @agntz/worker build

# ═══════════════════════════════════════════════════════════════
# Worker runtime
# ═══════════════════════════════════════════════════════════════
FROM base AS worker
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY --from=deps /app/packages/core/node_modules ./packages/core/node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=deps /app/packages/memrez/node_modules ./packages/memrez/node_modules
COPY --from=deps /app/packages/stores/node_modules ./packages/stores/node_modules
COPY --from=deps /app/packages/worker/node_modules ./packages/worker/node_modules
COPY --from=build /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=build /app/packages/contracts/package.json ./packages/contracts/
COPY --from=build /app/packages/core/dist ./packages/core/dist
COPY --from=build /app/packages/core/package.json ./packages/core/
COPY --from=build /app/packages/db/dist ./packages/db/dist
COPY --from=build /app/packages/db/package.json ./packages/db/
COPY --from=build /app/packages/memrez/dist ./packages/memrez/dist
COPY --from=build /app/packages/memrez/package.json ./packages/memrez/
COPY --from=build /app/packages/stores/dist ./packages/stores/dist
COPY --from=build /app/packages/stores/package.json ./packages/stores/
COPY --from=build /app/packages/worker/dist ./packages/worker/dist
COPY --from=build /app/packages/worker/package.json ./packages/worker/
COPY pnpm-workspace.yaml package.json ./
ENV PORT=4001
EXPOSE 4001
CMD ["node", "packages/worker/dist/server.js"]
